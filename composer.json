{
    "name": "enjoyscms/core",
    "description": "EnjoysCMS Core",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "doctrine/migrations": "^3.6",
        "doctrine/orm": "^2.8 | ^3.0",
        "enjoys/assets-collector": "^3.0",
        "enjoys/config": "^1.0",
        "enjoys/cookie": "^2.0",
        "enjoys/functions": "^2.0",
        "enjoys/session": "^2.0",
        "league/flysystem": "^3.0",
        "php-di/php-di": "^7.0",
        "psr/http-message": "^1.0 | ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "ramsey/uuid": "^4.1",
        "ramsey/uuid-doctrine": "^2.0",
        "symfony/finder": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/cache": "^7.2",
        "symfony/config": "^7.2",
        "symfony/psr-http-message-bridge": "^7.2",
        "twig/twig": "^3.20",
        "psr/event-dispatcher": "^1.0",
        "symfony/event-dispatcher-contracts": "^3.5"
    },
    "require-dev": {
        "infection/infection": "^0.27",
        "phpunit/phpunit": "^9.5",
        "fakerphp/faker": "^1.21",
        "guzzlehttp/guzzle": "^7.5.0",
        "symfony/var-dumper": "^7.2",
        "phpstan/extension-installer": ">=1.4.3",
        "phpstan/phpstan": "^2.1.11",
        "phpstan/phpstan-doctrine": "^2.0.2"
    },
    "scripts": {
        "tests": "XDEBUG_MODE=coverage ./vendor/bin/phpunit",
        "phpstan": "@php ./vendor/bin/phpstan analyze src",
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage  ./vendor/bin/infection -j2"
        ]
    },
    "autoload": {
        "psr-4": {
            "EnjoysCMS\\Core\\": "src/",
            "EnjoysCMS\\Core\\Composer\\Scripts\\": "scripts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\EnjoysCMS\\": "tests/"
        }
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
