{
    "name": "enjoyscms/core",
    "description": "EnjoysCMS Core",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "doctrine/migrations": "^3.6",
        "doctrine/orm": "^2.8 | ^3.0",
        "enjoys/assets-collector": "^2.0 | ^3.0",
        "enjoys/config": "^1.0",
        "enjoys/cookie": "^2.0",
        "enjoys/functions": "^2.0",
        "enjoys/session": "^2.0",
        "league/flysystem": "^3.0",
        "php-di/php-di": "^7.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^1.0 | ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "ramsey/uuid": "^4.1",
        "ramsey/uuid-doctrine": "^1.6 | ^2.0",
        "symfony/config": "^6.3 | ^7.0 | ^8.0",
        "symfony/console": "^6.3 | ^7.0 | ^8.0",
        "symfony/process": "^6.3 | ^7.0 | ^8.0",
        "symfony/finder": "^6.3 | ^7.0",
        "symfony/http-foundation": "^6.3 | ^7.0",
        "symfony/routing": "^6.4 | ^7.0",
        "symfony/event-dispatcher-contracts": "^3.0",
        "symfony/psr-http-message-bridge": "^2.1 | ^6.4 | ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "vimeo/psalm": "^6.0",
        "dg/bypass-finals": "^1.4",
        "fakerphp/faker": "^1.21",
        "guzzlehttp/guzzle": "^7.5.0",
        "symfony/var-dumper": "^6.3 | ^7.0 | ^8.0"
    },
    "scripts": {
        "register-commands": [
            "EnjoysCMS\\Core\\Composer\\Scripts\\RegisterCommandsToConsoleCommand"
        ],
        "post-install-cmd": [
            "@print-module-name Core",
            "@register-commands"
        ],
        "post-update-cmd": [
            "@print-module-name Core",
            "@register-commands"
        ],
        "psalm": "./vendor/bin/psalm --show-info=true --config=psalm.xml",
        "tests": "XDEBUG_MODE=coverage ./vendor/bin/phpunit",
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage  ./vendor/bin/infection -j2"
        ]
    },
    "autoload": {
        "psr-4": {
            "EnjoysCMS\\Core\\": "src/",
            "EnjoysCMS\\Core\\Composer\\Scripts\\": "scripts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\EnjoysCMS\\": "tests/"
        }
    },
    "bin": [
        "bin/console"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
